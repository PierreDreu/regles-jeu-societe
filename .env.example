# Token d'API BoardGameGeek (depuis juillet 2025, obligatoire)
# Inscription : https://boardgamegeek.com/using_the_xml_api
# Copier ce fichier en .env.local et y coller le token.
BGG_API_TOKEN=

# FTP de déploiement OVH (hébergement mutualisé)
# Récupérables dans l'espace client OVH → Hébergements → FTP/SSH
FTP_HOST=ftp.cluster100.hosting.ovh.net
FTP_USER=
FTP_PASSWORD=
# Répertoire cible sur le serveur (racine web sur l'hébergement mutualisé OVH)
FTP_REMOTE_DIR=/www
