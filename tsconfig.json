{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@scripts/*": ["./scripts/*"]
    },
    "resolveJsonModule": true,
    "types": ["astro/client", "node"]
  },
  "include": [".astro/types.d.ts", "src/**/*", "scripts/**/*.ts", "astro.config.mjs"],
  "exclude": ["node_modules", "dist", "data"]
}
