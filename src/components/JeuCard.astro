---
import type { Jeu } from "../lib/jeux";
import { formatJoueurs, formatDuree, formatComplexite } from "../lib/jeux";

export interface Props {
  jeu: Jeu;
}

const { jeu } = Astro.props;
const url = `/jeux/${jeu.slug}/`;
const hasPdf = jeu.pdfServingMode === "local" && jeu.pdfLocal;
---

<article class="jeu-card">
  <a class="jeu-card__cover" href={url} aria-label={`Voir la fiche de ${jeu.nom}`}>
    {
      jeu.image ? (
        <img src={jeu.image} alt={`Jaquette de ${jeu.nom}`} loading="lazy" />
      ) : (
        <div class="jeu-card__placeholder">{jeu.nom}</div>
      )
    }
  </a>
  <div class="jeu-card__body">
    <h3 class="jeu-card__title">
      <a href={url}>{jeu.nom}</a>
    </h3>
    {
      jeu.nomOriginal && jeu.nomOriginal !== jeu.nom && (
        <p class="jeu-card__alt">{jeu.nomOriginal}</p>
      )
    }
    <dl class="jeu-card__meta">
      <div><dt>Joueurs</dt><dd>{formatJoueurs(jeu)}</dd></div>
      <div><dt>Durée</dt><dd>{formatDuree(jeu)}</dd></div>
      <div><dt>Âge</dt><dd>{jeu.ageMin ? `${jeu.ageMin}+` : "—"}</dd></div>
      <div><dt>Complexité</dt><dd>{formatComplexite(jeu.poidsRegles)}</dd></div>
    </dl>
    {hasPdf && <p class="jeu-card__badge">📄 Règles PDF disponibles</p>}
  </div>
</article>

<style>
  .jeu-card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .jeu-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  .jeu-card__cover {
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #f5f1e6;
  }
  .jeu-card__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .jeu-card__placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    font-family: var(--font-serif);
    color: var(--color-text-muted);
    padding: 1rem;
    text-align: center;
  }
  .jeu-card__body {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .jeu-card__title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    line-height: 1.25;
    margin: 0;
  }
  .jeu-card__title a {
    color: var(--color-text);
    text-decoration: none;
  }
  .jeu-card__title a:hover {
    color: var(--color-accent);
  }
  .jeu-card__alt {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0;
    font-style: italic;
  }
  .jeu-card__meta {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.25rem 0.75rem;
    margin: 0.25rem 0 0;
    font-size: 0.85rem;
  }
  .jeu-card__meta div {
    display: flex;
    gap: 0.35rem;
  }
  .jeu-card__meta dt {
    color: var(--color-text-muted);
  }
  .jeu-card__meta dd {
    margin: 0;
    font-weight: 500;
  }
  .jeu-card__badge {
    margin: 0.25rem 0 0;
    font-size: 0.8rem;
    color: var(--color-success);
    font-weight: 500;
  }
</style>
